    "@geo-copilot/crawler": "workspace:*",
    "@geo-copilot/scorer": "workspace:*",
    "@geo-copilot/somv-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  }
